{% macro afficheCasting(casting) %}
    <li class="relative rounded-xl overflow-hidden transition cursor-pointer hover:scale-105 hover:opacity-90 hover:shadow-md">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Tom_Hardy_by_Gage_Skidmore.jpg/520px-Tom_Hardy_by_Gage_Skidmore.jpg" class="object-cover h-full w-full -z-10" alt="">
        <div class="absolute top-0 h-full w-full bg-gradient-to-t from-black/50 p-3 flex flex-col justify-end">
            <div class="self-center flex flex-col items-center space-y-2">
                <span class="capitalize text-white font-medium drop-shadow-md">{{casting['name']}}</span>
                <span class="text-gray-100 text-xs truncate">{{casting['role']}}</span>
            </div>
        </div>
    </li>
{% endmacro %}